# Workspace/runtime state
.codex-attachments/
.flutter-tmp/
.flutter-tool-data/
.gradle-user-home/
captures/
scratch/

# Flutter/Dart/Gradle outputs and caches
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/local.properties
**/.gradle/

# Generated test artifacts
**/test/failures/
**/test/goldens/*.png
**/__pycache__/

# Editor and OS state
**/.idea/
**/*.iml
**/.DS_Store

# Keep the requested APK explicitly with git add -f; other generated APKs stay out.
**/*.apk
**/*.apk.sha1
