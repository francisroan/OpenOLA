  "command_rx_topology": {
    "_note": "All command frames: byte0 = ordinal (uint8), bytes1-7 = 0 padding. These are the READ/ack side the head unit parses (VehicleCommandParser).",
    "0x6D0": "parserVehicleCommand -> CommandFromVehicle  (vehicle->HU NOTIFICATIONS: derates, faults, why-no-mode, upgrade prompts, charging msgs). NOT actuation.",
    "0x6C0": "parseCommandAck -> CommandFromHMI  (ack/echo of a 0x6BC command; byte0 = same ordinal)",
    "0x61A": "parseCloudCommandAck -> CommandFromApp  (ack of a cloud/app command)",
    "0x65B": "parseAckCommandFromKrutrim -> CommandFromKrutrim  (ack of an AI-assistant command)",
    "0x6AE": "parseActivatePasscodeWindow -> byte0 bit0 = passcode entry window active",
    "0x66F": "parseAckFromBCM -> byte0 bit0 = variant ack (boolean)",
    "0x6BC": "TX (send) side: write byte0 = CommandFromHMI ordinal to actuate; ack on 0x6C0"
  },
